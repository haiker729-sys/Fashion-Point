# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# PHASE 7: RAZORPAY PAYMENT GATEWAY CONFIGURATION
# ---------------------------------------------------------------------------
# Official Dashboard: https://dashboard.razorpay.com/
# Docs: https://razorpay.com/docs/
#
# NEVER commit real keys or secrets to version control.
# Configure real secrets via your deployment Secrets panel or local .env file.

# Public Key ID exposed to browser for Razorpay Checkout modal ONLY (e.g. rzp_test_xxxxxxxx)
VITE_RAZORPAY_KEY_ID=""

# Backend-ONLY Razorpay API credentials (NEVER expose to frontend)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Backend-ONLY Razorpay Webhook Signing Secret (configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=""

# Safety Gate: Live keys (rzp_live_*) remain disabled until explicitly enabled by the store owner
RAZORPAY_ALLOW_LIVE="false"

# Optional: Set when hosting static frontend on GitHub Pages with a separate Node.js backend
VITE_API_BASE_URL=""
CORS_ALLOWED_ORIGIN=""
